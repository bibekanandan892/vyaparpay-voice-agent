<?xml version="1.0" encoding="utf-8"?>
<!--
  The module that owns the sockets owns the permission. Nothing else in the
  scaffold declares a permission yet: RECORD_AUDIO, FOREGROUND_SERVICE and
  POST_NOTIFICATIONS arrive in :voice's manifest together with the service that
  needs them (docs/03 §3.3), not ahead of it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      docs/14 mandates TLS everywhere (HTTPS + WSS). Android only denies
      cleartext by default from API 28; minSdk is 24, so the module that
      owns the sockets also owns the opt-out — merged into the app
      manifest before any real base URL is wired in.
    -->
    <application android:usesCleartextTraffic="false" />

</manifest>
