# backend/.env.example — template for backend/.env (gitignored).
#
# Every var below maps 1:1 to a field on Settings in app/config.py
# (pydantic-settings matches env vars to field names case-insensitively,
# no prefix). Fields with no default in Settings are REQUIRED — the
# process fails fast at startup if they're unset.
#
# NOTE on hostnames: the values here use `localhost`, because this file
# is also the template for running the backend directly on the host
# (outside Docker), e.g. `uvicorn app.main:app` against a locally
# published Postgres/Redis port (root docker-compose.yml binds both to
# 127.0.0.1 for exactly this use). When running via docker-compose.yml
# instead, the agent-api service's own `environment:` block overrides
# DATABASE_URL/REDIS_URL to the compose service hostnames automatically
# — no manual edit needed for those two vars under that path.

# --- Core ---
ENV=dev
LOG_LEVEL=INFO

# --- Auth (required, no default — demo JWT signing/verification secret) ---
JWT_SECRET=dev-secret-change-me

# --- Data layer (required, no default) ---
DATABASE_URL=postgresql+asyncpg://vyapar:vyapar@localhost:5432/vyapar
REDIS_URL=redis://localhost:6379/0

# --- OpenRouter LLM provider (API key required, no default) ---
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DIALOGUE_MODEL=anthropic/claude-sonnet-5
OPENROUTER_UTILITY_MODEL=anthropic/claude-haiku-4-5
# Comma-separated fallback slugs, e.g. "openai/gpt-5.1,google/gemini-3-pro"
OPENROUTER_DIALOGUE_FALLBACKS=

# --- OpenTelemetry (optional — leave endpoint unset to disable export) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agent-api

# --- Session / rate limiting / cost guard ---
SESSION_TTL_SECONDS=86400
RATE_LIMIT_SESSIONS_PER_MIN=5
CALL_COST_CAP_USD=1.00
# First-token deadline for turn-path LLM calls. 1.5 (the default) is
# docs/05 §3.4's budget for paid voice-grade models; raise to ~8.0 when
# using slower models (e.g. OpenRouter :free slugs), whose first token
# routinely takes longer — every miss burns the one retry or fails the
# whole turn to the spoken apology.
#LLM_TTFT_DEADLINE_S=1.5

# ======================================================================
# Phase 3 — voice pipeline (docs/06-voice-pipeline.md)
#
# Every var below is OPTIONAL for agent-api: it (and the whole test
# suite) boots with none of them set. Vars tagged [voice-worker] are
# required by the voice worker, which fail-fasts at its own startup if
# they're missing — everything else has a sensible default.
# ======================================================================

# --- STT: Deepgram streaming (docs/06 §1) ---
# [voice-worker] API key — required only for the voice worker.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_URL=wss://api.deepgram.com/v1/listen

# --- TTS: ElevenLabs Flash (docs/06 §1) ---
# [voice-worker] API key and primary voice id — required only for the
# voice worker. Fallback voice id is optional (empty = no fallback).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_FALLBACK_VOICE_ID=
ELEVENLABS_URL=https://api.elevenlabs.io

# --- WebRTC / signaling (docs/06 §2) ---
# [voice-worker] TURN shared secret (coturn use-auth-secret), coturn
# public host, and the public wss base of /v1/signal returned in the
# session response — required for real calls; TTLs/grace have defaults.
TURN_SECRET=
COTURN_HOST=
SIGNALING_PUBLIC_URL=
SIGNALING_TOKEN_TTL_S=300
TURN_CREDENTIAL_TTL_S=600
SESSION_GRACE_S=30
# [voice-worker] where /v1/signal listens (app/voice/run.py). 0.0.0.0
# because a real phone must reach it; keep the port in lockstep with
# docker-compose.yml's 8080:8080 mapping.
SIGNALING_BIND_HOST=0.0.0.0
SIGNALING_BIND_PORT=8080
# coturn-only, NOT a Settings field: read by the coturn container's
# entrypoint (docker-compose.yml), appended as coturn's `external-ip` so
# relay candidates advertise a host-reachable address instead of the
# 172.x bridge IP. Leave unset for pure-localhost runs.
#TURN_EXTERNAL_IP=

# --- VAD / endpointing (docs/06 §5-§6 canonical defaults) ---
# Tuning knobs only — every one has a default, nothing required.
VAD_THRESHOLD=0.5
MIN_SPEECH_MS=200
ENDPOINT_SILENCE_MS=250
MAX_ENDPOINT_DELAY_MS=2000

# ======================================================================
# Phase 5 — memory / RAG (docs/09-memory-architecture.md)
#
# Optional: unset means no embeddings, ever (app/config.py's own
# comment — the whole standard test suite boots with none of this set).
# Retrieval and the post-call summary embed step both silently no-op
# without it; nothing else in the app is affected.
# ======================================================================

# --- Embeddings: OpenAI text-embedding-3-small, 1536-dim (docs/09 §6.1) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Same width only — swapping to a different-width model silently
# corrupts existing vectors (app/config.py's own comment). Leave unset
# to use the pinned default.
#OPENAI_EMBEDDING_MODEL=
BARGE_IN_DEBOUNCE_MS=100
