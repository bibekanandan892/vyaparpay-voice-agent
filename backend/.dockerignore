# backend/.dockerignore — Dockerfile does `COPY . .` from this directory
# (build context is ./backend, per root docker-compose.yml). Without this
# file, backend/.env (real secrets: JWT_SECRET, DATABASE_URL credentials,
# OPENROUTER_API_KEY) gets baked into an image layer the moment a
# developer follows .env.example's own instructions and creates it —
# recoverable from `docker history`/`docker save` even after a later
# layer, and permanently so if the image is ever pushed to a registry.

.env
.env.*
!.env.example

.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

.git/
tests/
